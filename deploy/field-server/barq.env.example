# Public IPv4 of this VPS — this is what M25 AT+QIOPEN must dial.
# Do not use a hostname. 2G DNS on M25MAR01A12 is unreliable.
BARQ_MODE=field
BARQ_ENABLE_USB=0
BARQ_ENABLE_PINGGY=0
BARQ_RELAY_HOST=203.0.113.10
BARQ_RELAY_PORT=5050
BARQ_APN=internet
BARQ_FAILSAFE_MS=15000
BARQ_ARM_WINDOW_MS=30000
PORT=4000
WS_PORT=4001
TCP_PORT=5050
