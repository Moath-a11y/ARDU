# ──────────────────────────────────────────────────
# BARQ LINK · .env.example
# انسخ هذا الملف إلى ".env" واملأ قيمك الخاصة
# ──────────────────────────────────────────────────

# ═══ Telegram Bot (لإشعارات الرابط وحالة الجهاز) ════
# 1. اذهب إلى @BotFather في تيليغرام وأنشئ بوت جديد
# 2. احصل على TOKEN من BotFather
# 3. أرسل رسالة للبوت ثم افتح: https://api.telegram.org/bot<TOKEN>/getUpdates
#    وخذ "id" من "chat" — هذا هو CHAT_ID الخاص بك
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ-example
TELEGRAM_CHAT_ID=987654321

# ═══ بيئة السحابة (Fly.io) ════
# هذه تُضبط تلقائياً في fly.toml — لا تحتاج تعديلها هنا
# PUBLIC_URL=https://barq-link.fly.dev
# PUBLIC_HOST=barq-link.fly.dev
# NO_AUTO_TUNNEL=1
